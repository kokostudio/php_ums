APP_NAME="Standard Core System"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=php_ums
DB_USERNAME=root
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# OAuth 2.0 Settings
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

LINE_CLIENT_ID=your_line_client_id
LINE_CLIENT_SECRET=your_line_client_secret
LINE_REDIRECT_URI=http://localhost/auth/line/callback

# Security
# APP_KEY — ใช้สำหรับ Hashids salt และ AES-256-GCM encryption
# ต้องสุ่มค่าใหม่ทุกครั้งที่ติดตั้ง (เว้นว่างไว้ Web Installer จะ generate ให้อัตโนมัติ)
APP_KEY=

# Trusted Reverse Proxies (คั่นด้วย comma) — ระบุเฉพาะเมื่อรันหลัง reverse proxy
# และต้องการให้ RateLimiter ใช้ X-Forwarded-For (เช่น 127.0.0.1,10.0.0.5)
TRUSTED_PROXIES=
