# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# AutoCode agent memory — local session state, not committed.
.autocode/

# Agent / scanner local state (Mimosa, ZCode session artifacts)
.mimosa/
.zcode/

# One-off working scripts — ใช้เสร็จลบ ไม่เก็บใน repo
scratch/

# PHP
vendor/
.env

# Node
node_modules/
package-lock.json

# Logs & DB
/storage/logs/
*.log
*.sqlite

# User Uploads & Cache (เก็บโครงสร้างโฟลเดอร์ไว้ผ่าน .gitkeep)
storage/cache/
storage/installed.lock
public/uploads/*
!public/uploads/*/.gitkeep

# Build & Archives
*.zip

# ไฟล์ทดสอบ/สำรองชั่วคราวที่ห้ามติด repo
test_*.php
test_*.html
old_*
diff*.txt
*_backup*
